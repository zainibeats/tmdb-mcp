FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1

COPY requirements.txt .
# mcpo 0.0.20 declares `mcp>=1.17.0` with no upper bound, but imports
# `streamablehttp_client`, which the mcp SDK renamed in 2.0. Cap mcp at
# 1.x until mcpo supports the 2.x API.
RUN pip install --no-cache-dir -r requirements.txt mcpo "mcp<2"

COPY tmdb_server.py .
COPY tmdb_formatting.py .

RUN useradd -m -u 1000 mcpuser && \
    chown -R mcpuser:mcpuser /app

USER mcpuser

EXPOSE 8000

CMD ["mcpo", "--host", "0.0.0.0", "--port", "8000", "--", "python", "tmdb_server.py"]
